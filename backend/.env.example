# ── Database ────────────────────────────────────────────
# Replace with your PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ── Server ──────────────────────────────────────────────
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173,http://localhost:5174,http://127.0.0.1:5174,http://[::1]:5174
NODE_ENV=development

# ── Auth (JWT) ──────────────────────────────────────────
# Replace with a long random hex string
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# SMTP Configuration
# For Gmail SMTP / Google App Password configuration:
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords.
# 2. Generate a new App Password (e.g. VendorBridge).
# 3. Use the following settings:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=465
#    SMTP_SECURE=true
#    SMTP_USER=your-email@gmail.com
#    SMTP_PASS=xxxxxxxxxxxxxxxx (the 16-character app password, without spaces)
#    SMTP_FROM="VendorBridge" <your-email@gmail.com>
# Note: If SMTP variables are left empty, the application will fallback to development mode
# and write all generated OTPs directly to "backend/dev_otp.log" in the workspace.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VendorBridge <no-reply@vendorbridge.local>"
