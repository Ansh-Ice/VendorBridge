// VendorBridge - Prisma Schema
// Procurement & Vendor Management ERP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────
// Organization (Tenant)
// ──────────────────────────────────────
model Organization {
  id             String   @id @default(uuid())
  name           String
  legalName      String?
  gstin          String?
  billingAddress String?
  stateCode      String?  // for GST calculation (e.g. "MH", "DL")
  currency       String   @default("INR")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users            User[]
  vendors          Vendor[]
  rfqs             RFQ[]
  quotations       Quotation[]
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  approvalRules    ApprovalRule[]
  approvalRequests ApprovalRequest[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  emailLogs        EmailLog[]
  documentCounters DocumentCounter[]
  attachments      Attachment[]
  vendorCategories VendorCategory[]

  @@map("organizations")
}

// ──────────────────────────────────────
// Users
// ──────────────────────────────────────
model User {
  id                     String   @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  vendorId               String?  // Only set if user belongs to a VENDOR
  vendor                 Vendor?  @relation("VendorUsers", fields: [vendorId], references: [id])
  name                   String
  email                  String   @unique
  password               String
  role                   Role     @default(PROCUREMENT_OFFICER)
  status                 UserStatus @default(ACTIVE)
  lastLoginAt            DateTime?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  rfqs             RFQ[]
  approvalSteps    ApprovalStep[]
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  approvalRequests ApprovalRequest[] // requested by this user

  @@map("users")
}

enum Role {
  ADMIN
  PROCUREMENT_OFFICER
  VENDOR
  APPROVER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

// ──────────────────────────────────────
// Vendors
// ──────────────────────────────────────
model Vendor {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  legalName      String?
  email          String   @unique
  phone          String?
  contactName    String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  stateCode      String?  // for GST calculation (e.g. "KA", "MH")
  postalCode     String?
  country        String?  @default("India")
  gstin          String?
  pan            String?
  categoryId     String?
  category       VendorCategory? @relation(fields: [categoryId], references: [id])
  status         VendorStatus @default(ACTIVE)
  rating         Float    @default(0.0)
  paymentTerms   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]   @relation("VendorUsers")
  rfqVendors     RFQVendor[]
  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@map("vendors")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
  PENDING_REVIEW
}

model VendorCategory {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?

  vendors        Vendor[]

  @@unique([organizationId, name])
  @@map("vendor_categories")
}

// ──────────────────────────────────────
// RFQs (Request for Quotations)
// ──────────────────────────────────────
model RFQ {
  id                  String    @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  rfqNumber           String
  title               String
  description         String?
  categoryId          String?
  currency            String    @default("INR")
  budget              Float?
  deadline            DateTime?
  terms               String?
  status              RFQStatus @default(DRAFT)
  createdById         String
  createdBy           User      @relation(fields: [createdById], references: [id])
  selectedQuotationId String?   @unique
  selectedQuotation   Quotation? @relation("RFQSelectedQuotation", fields: [selectedQuotationId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  publishedAt         DateTime?
  closedAt            DateTime?

  lineItems           RFQLineItem[]
  rfqVendors          RFQVendor[]
  quotations          Quotation[]
  approvalRequests    ApprovalRequest[]
  purchaseOrders      PurchaseOrder[]

  @@unique([organizationId, rfqNumber])
  @@map("rfqs")
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  QUOTING
  CLOSED
  COMPARISON
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  AWARDED
  CANCELLED
}

model RFQLineItem {
  id          String   @id @default(uuid())
  rfqId       String
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Float
  unit        String
  targetPrice Float?
  requiredBy  DateTime?
  sortOrder   Int      @default(0)

  quotationLineItems QuotationLineItem[]

  @@map("rfq_line_items")
}

model RFQVendor {
  id          String   @id @default(uuid())
  rfqId       String
  vendorId    String
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status      RFQVendorInviteStatus @default(INVITED)
  invitedAt   DateTime @default(now())
  viewedAt    DateTime?
  respondedAt DateTime?

  @@unique([rfqId, vendorId])
  @@map("rfq_vendors")
}

enum RFQVendorInviteStatus {
  INVITED
  VIEWED
  QUOTED
  DECLINED
  EXPIRED
}

// ──────────────────────────────────────
// Quotations
// ──────────────────────────────────────
model Quotation {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  rfqId          String
  vendorId       String
  quoteNumber    String
  subtotal       Float
  taxAmount      Float
  shippingAmount Float    @default(0.0)
  discountAmount Float    @default(0.0)
  grandTotal     Float
  currency       String   @default("INR")
  deliveryDays   Int
  validUntil     DateTime
  paymentTerms   String?
  notes          String?
  status         QuotationStatus @default(DRAFT)
  submittedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rfq            RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lineItems      QuotationLineItem[]
  selectedByRFQs RFQ[]    @relation("RFQSelectedQuotation")
  approvalRequests ApprovalRequest[]
  purchaseOrders PurchaseOrder[]

  @@unique([rfqId, vendorId])
  @@unique([organizationId, quoteNumber])
  @@map("quotations")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  REVISED
  WITHDRAWN
  SHORTLISTED
  ACCEPTED
  REJECTED
}

model QuotationLineItem {
  id             String   @id @default(uuid())
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqLineItemId  String
  rfqLineItem    RFQLineItem @relation(fields: [rfqLineItemId], references: [id], onDelete: Cascade)
  unitPrice      Float
  quantity       Float
  taxRate        Float    @default(18.0)
  lineSubtotal   Float
  lineTax        Float
  lineTotal      Float
  deliveryDays   Int?
  notes          String?

  @@map("quotation_line_items")
}

// ──────────────────────────────────────
// Approvals
// ──────────────────────────────────────
model ApprovalRequest {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  rfqId          String
  rfq            RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotationId    String
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User      @relation(fields: [requestedById], references: [id])
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  steps          ApprovalStep[]
  purchaseOrders PurchaseOrder[]

  @@map("approval_requests")
}

model ApprovalStep {
  id                String   @id @default(uuid())
  approvalRequestId String
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approverId        String
  approver          User      @relation(fields: [approverId], references: [id])
  sequence          Int       @default(1)
  status            ApprovalStepStatus @default(PENDING)
  remarks           String?
  decidedAt         DateTime?
  createdAt         DateTime @default(now())

  @@map("approval_steps")
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRule {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  minAmount      Float    @default(0.0)
  maxAmount      Float?
  approversJson  String   // JSON array of user IDs
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("approval_rules")
}

// ──────────────────────────────────────
// Purchase Orders
// ──────────────────────────────────────
model PurchaseOrder {
  id                   String   @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  poNumber             String
  rfqId                String
  rfq                  RFQ      @relation(fields: [rfqId], references: [id])
  quotationId          String
  quotation            Quotation @relation(fields: [quotationId], references: [id])
  approvalRequestId    String
  approvalRequest      ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  vendorId             String
  vendor               Vendor   @relation(fields: [vendorId], references: [id])
  status               POStatus @default(DRAFT)
  issueDate            DateTime @default(now())
  expectedDeliveryDate DateTime?
  subtotal             Float
  taxAmount            Float
  grandTotal           Float
  terms                String?
  generatedById        String
  generatedBy          User     @relation(fields: [generatedById], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  lineItems            PurchaseOrderLineItem[]
  invoices             Invoice[]

  @@unique([organizationId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLineItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  quantity        Float
  unit            String
  unitPrice       Float
  taxRate         Float
  lineSubtotal    Float
  lineTax         Float
  lineTotal       Float

  @@map("purchase_order_line_items")
}

enum POStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

// ──────────────────────────────────────
// Invoices
// ──────────────────────────────────────
model Invoice {
  id              String   @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  invoiceNumber   String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  vendorId        String
  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  status          InvoiceStatus @default(DRAFT)
  invoiceDate     DateTime @default(now())
  dueDate         DateTime
  subtotal        Float
  cgst            Float    @default(0.0)
  sgst            Float    @default(0.0)
  igst            Float    @default(0.0)
  taxAmount       Float
  roundOff        Float    @default(0.0)
  grandTotal      Float
  pdfPath         String?
  emailedAt       DateTime?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lineItems       InvoiceLineItem[]

  @@unique([organizationId, invoiceNumber])
  @@map("invoices")
}

model InvoiceLineItem {
  id           String   @id @default(uuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  quantity     Float
  unit         String
  unitPrice    Float
  taxRate      Float
  lineSubtotal Float
  lineTax      Float
  lineTotal    Float

  @@map("invoice_line_items")
}

enum InvoiceStatus {
  DRAFT
  GENERATED
  SENT
  PAID
  OVERDUE
  VOID
}

// ──────────────────────────────────────
// Support Models (Logs, Alerts, Documents)
// ──────────────────────────────────────
model ActivityLog {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actorVendorId  String?
  entityType     String
  entityId       String
  action         String
  message        String
  metadataJson   String?
  createdAt      DateTime @default(now())

  @@map("activity_logs")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  type           String
  title          String
  body           String
  entityType     String?
  entityId       String?
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@map("notifications")
}

model EmailLog {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entityType     String?
  entityId       String?
  recipient      String
  subject        String
  status         EmailStatus @default(QUEUED)
  providerMsgId  String?
  error          String?
  createdAt      DateTime @default(now())
  sentAt         DateTime?

  @@map("email_logs")
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model DocumentCounter {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  financialYear  String
  nextNumber     Int      @default(1)

  @@unique([organizationId, type, financialYear])
  @@map("document_counters")
}

model Attachment {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerType      String
  ownerId        String
  fileName       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  uploadedById   String
  createdAt      DateTime @default(now())

  @@map("attachments")
}
